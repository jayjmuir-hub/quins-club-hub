+        },
+      },
+      animation: {
+        'sheet-slide-up': 'sheetSlideUp .28s cubic-bezier(.32,.72,0,1)',
+        'sheet-scale-in': 'sheetScaleIn .2s ease-out',
+        'scrim-fade-in': 'scrimFadeIn .2s ease',
+      },
     },
   },
   plugins: [],
 }
