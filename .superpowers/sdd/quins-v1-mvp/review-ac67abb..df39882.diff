+    expect(clubWallTimeToUtc('2026-07-30', '')).toBeNull()
+    expect(clubWallTimeToUtc(null, null)).toBeNull()
+    expect(clubWallTimeToUtc('30/07/2026', '20:00')).toBeNull()
