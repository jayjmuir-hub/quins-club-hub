+++
+++  if (loading) {
+++    return (
+++      <div className="flex justify-center py-6">
+++        <Spinner label="Loading availability…" />
+++      </div>
+++    )
+++  }
+++
+++  if (error) {
+++    return (
+++      <p role="alert" className="rounded-[11px] bg-[#fbeae8] px-3 py-2 text-sm font-semibold text-quinsRedDark">
