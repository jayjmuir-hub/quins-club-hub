+    results.push({ shot: shot.file, viewport: vp.name, file: outPath, metrics, consoleErrors, consoleWarnings, pageErrors })
+    await page.close()
+  }
+}
+
+await browser.close()
+fs.writeFileSync(path.join(outDir, 'metrics.json'), JSON.stringify(results, null, 2))
+console.log(
